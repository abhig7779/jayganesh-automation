APP_NAME="Jay Ganesh CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Proxies allowed to pass on the real client IP (X-Forwarded-For). Empty = none. Never '*'.
TRUSTED_PROXIES=

# Security headers: enforce | report-only | off. FORCE_HTTPS only acts when APP_ENV=production.
SECURITY_CSP=enforce
FORCE_HTTPS=true

# Hosts whose browser session may call /api/v1 with the login cookie (defaults to APP_URL's host).
# SANCTUM_STATEFUL_DOMAINS=crm.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp Cloud API (crm/WHATSAPP-TEMPLATES.md has the go-live checklist) ---
# Leave these empty while Settings > WhatsApp > Sending mode is "Manual". Never commit real values.
# Permanent System User token with the whatsapp_business_messaging permission.
WHATSAPP_TOKEN=
# WhatsApp Manager > Phone numbers > "Phone number ID" (a long id, not the mobile number).
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID.
WHATSAPP_WABA_ID=
# Meta app > Settings > Basic > App secret (checks X-Hub-Signature-256 on every webhook).
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value as the "Verify token" in the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_QUEUE_CONNECTION=database
