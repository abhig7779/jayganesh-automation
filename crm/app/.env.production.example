# REDIS_BACKOFF_CAP=
# REDIS_CACHE_CONNECTION=
# REDIS_CACHE_DB=
# REDIS_CACHE_LOCK_CONNECTION=
# REDIS_CLUSTER=
# REDIS_DB=
# REDIS_MAX_RETRIES=
# REDIS_PERSISTENT=
# REDIS_PREFIX=
# REDIS_QUEUE=
# REDIS_QUEUE_CONNECTION=
# REDIS_QUEUE_RETRY_AFTER=
# REDIS_URL=
# REDIS_USERNAME=
# RESEND_API_KEY=
# SANCTUM_TOKEN_PREFIX=
# SESSION_CONNECTION=
# SESSION_COOKIE=
# SESSION_EXPIRE_ON_CLOSE=
# SESSION_PARTITIONED_COOKIE=
# SESSION_STORE=
# SESSION_TABLE=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=
# --- Lead intake: website form + Meta lead ads (crm/LEADS-API.md) ---
# The website form's key is made in the CRM: Owner > API keys (not here).
# Limits for POST /api/v1/leads: per caller IP per minute, and per key per hour.
LEADS_API_PER_MINUTE=20
LEADS_API_PER_HOUR=300
# Meta lead ads webhook (/webhooks/meta-leads). Leave false until the Facebook page is connected.
META_LEADS_ENABLED=false
# Meta app > Settings > Basic > App secret. Leave empty to use WHATSAPP_APP_SECRET (same app).
META_LEADS_APP_SECRET=
# Any long random string; paste the same value as the "Verify token" in the Meta webhook setup.
META_LEADS_VERIFY_TOKEN=
# System User token for the Facebook page, with leads_retrieval and pages_manage_metadata.
META_LEADS_PAGE_TOKEN=
# Graph API version used to read leads (defaults to WHATSAPP_GRAPH_VERSION).
META_GRAPH_VERSION=v23.0

# Connect WhatsApp (Meta Embedded Signup, coexistence). Public IDs, not secrets.
WHATSAPP_APP_ID=2901906313477061
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=4202556123367996

# AI auto-reply for ad chats (off until the owner picks a provider in Settings → WhatsApp).
ANTHROPIC_API_KEY=
WHATSAPP_AI_CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
WHATSAPP_AI_OPENAI_MODEL=gpt-5.4
WHATSAPP_AI_DEBOUNCE_SECONDS=20
WHATSAPP_AI_MAX_REPLIES_PER_DAY=8
WHATSAPP_AI_PAUSE_HOURS_AFTER_OWNER=12
WHATSAPP_AI_PAUSE_HOURS_AFTER_HANDOFF=24
