# =====================================================================
# Jay Ganesh CRM: production settings (MilesWeb, crm.jayganeshcaraccessories.com)
#
# On the server:  cd ~/crm-app && cp .env.production.example .env && nano .env
# Then:           php artisan key:generate --force && php artisan config:cache
#
# NEVER commit the real .env. This repo is PUBLIC. Fill the blanks only on the server.
# After any change to .env, run:  php artisan config:cache
# =====================================================================

# --- App -------------------------------------------------------------
APP_NAME="Jay Ganesh CRM"
APP_ENV=production
# Filled by `php artisan key:generate`. Keep a copy in the owner's password manager:
# losing it logs everyone out and makes encrypted values unreadable.
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.jayganeshcaraccessories.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs (one file per day, kept 14 days; the daily error email reads these) ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (create it in mPanel > Databases; see crm/DEPLOY.md step 1) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# mPanel usually prefixes names with the account user, e.g. abcd_crm
DB_DATABASE=
DB_USERNAME=
# Typed by the owner on the server only.
DB_PASSWORD=
# Only if `which mysqldump` finds nothing: the FOLDER that holds mysqldump, e.g. /usr/bin/
# DB_DUMP_BINARY_PATH=

# --- Sessions and login cookie ---
SESSION_DRIVER=database
# Minutes. Owner/Finance get a shorter idle limit inside the app.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=crm.jayganeshcaraccessories.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Hosts whose browser session may call /api/v1 with the login cookie.
SANCTUM_STATEFUL_DOMAINS=crm.jayganeshcaraccessories.com

# --- Queue and cache (database: works on shared hosting with the one cron line) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=jgcrm_
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# If Redis is switched on in mPanel later, these can move to redis:
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Mail (a mailbox created in mPanel > Email, e.g. crm@jayganeshcaraccessories.com) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.jayganeshcaraccessories.com
MAIL_PORT=465
MAIL_USERNAME=crm@jayganeshcaraccessories.com
# Typed by the owner on the server only.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=crm@jayganeshcaraccessories.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Backups (config/backup.php; restore steps in crm/RESTORE.md) ---
# Folder name under storage/app/backups/. The Google Drive copy job expects this value.
BACKUP_NAME=jayganesh-crm
# Who gets an email when a backup fails or is older than a day.
BACKUP_NOTIFY_EMAIL=
# Password that encrypts the backup zip (AES-256). Strongly recommended, because copies go
# to Google Drive. Save it in the owner's password manager: without it a backup can't be opened.
BACKUP_ARCHIVE_PASSWORD=

# --- Health and alerts (config/ops.php) ---
# Daily 08:00 IST email with yesterday's errors; skipped when there are none.
ERROR_DIGEST_ENABLED=true
# Defaults to BACKUP_NOTIFY_EMAIL when empty.
ERROR_DIGEST_EMAIL=
HEALTH_QUEUE_LAG_MINUTES=10
HEALTH_BACKUP_MAX_AGE_HOURS=26
HEALTH_HEARTBEAT_MAX_MINUTES=3

# --- Security headers (app/Http/Middleware/SecurityHeaders.php) ---
# enforce | report-only | off. Use report-only for a day if a new screen breaks.
SECURITY_CSP=enforce
# Redirect http:// to https://. Set false only if it causes a redirect loop.
FORCE_HTTPS=true

# --- WhatsApp Cloud API (Meta). Leave empty until the number is connected;
# the CRM then works in "manual mode" (wa.me links). ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent system-user token. Server only.
WHATSAPP_ACCESS_TOKEN=
# Used to check the X-Hub-Signature-256 header on the webhook. Server only.
WHATSAPP_APP_SECRET=
# Any long random string; typed into Meta's webhook settings as the "verify token".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

VITE_APP_NAME="${APP_NAME}"
